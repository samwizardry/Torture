<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Workstation GC: для клиентской игры это правильно. Server GC = куча на каждое ядро,
       больше памяти, его потоки конкурируют с потоками игры/рендера. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Background GC: gen2 идёт параллельно с кадром. Без него SustainedLowLatency бесполезен. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Не отдавать освобождённые сегменты ОС, а держать их про запас: меньше скачков при повторном росте кучи. -->
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Torture.Core\Torture.Core.csproj" />
    <ProjectReference Include="..\Torture.Graphics.Direct3D11\Torture.Graphics.Direct3D11.csproj" Condition="'$(TortureTargetOS)' == 'Windows'" />
    <ProjectReference Include="..\Torture.Graphics.Vulkan\Torture.Graphics.Vulkan.csproj" Condition="'$(TortureTargetOS)' == 'Linux' or '$(TortureTargetOS)' == 'Windows'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Triangle.hlsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
